### Legacy client: initialize (2025-11-25 and older)
# @no-redirect
POST {{ base-url }}/mcp
Authorization: Bearer {{ bearer-token }}
Content-Type: application/json
Accept: application/json, text/event-stream

{
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {"protocolVersion": "2025-11-25", "capabilities": {}, "clientInfo": {"name": "http-client", "version": "1"}}
}

### Legacy client: initialized notification (202, no body)
# @no-redirect
POST {{ base-url }}/mcp
Authorization: Bearer {{ bearer-token }}
Content-Type: application/json
MCP-Protocol-Version: 2025-11-25

{
    "jsonrpc": "2.0",
    "method": "notifications/initialized"
}

